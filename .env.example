# 应用
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
UVICORN_ACCESS_LOG=false
AUTO_CREATE_TABLES=true
CHAT_PROVIDER=deepseek
AGENT_EXECUTION_MODE=live

# DeepSeek 对话模型
DEEPSEEK_API_KEY=replace-with-rotated-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# Embedding 服务，必须与 Milvus 向量维度一致
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_API_KEY=replace-with-embedding-key
EMBEDDING_BASE_URL=replace-with-embedding-base-url
EMBEDDING_MODEL=replace-with-embedding-model
EMBEDDING_DIMENSION=1024

# DashScope 兼容 Embedding，可作为通用 Embedding 配置的回退
DASHSCOPE_API_KEY=replace-with-dashscope-key
DASHSCOPE_BASE_URL=replace-with-dashscope-compatible-base-url
DASHSCOPE_CHAT_MODEL=qwen3.8-flash
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding
DASHSCOPE_EMBEDDING_DIMENSION=1024

# Reranker 为可选增强项
RERANK_API_KEY=
RERANK_BASE_URL=
RERANK_MODEL=

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=multiagent
POSTGRES_USER=multiagent
POSTGRES_PASSWORD=replace-with-database-password

# Milvus，运行在用户虚拟机的 Docker 中
MILVUS_URI=http://replace-with-vm-ip:19530
MILVUS_USER=replace-with-milvus-user
MILVUS_PASSWORD=replace-with-milvus-password
MILVUS_TOKEN=
MILVUS_DATABASE=default
MILVUS_TOP_K=8

# Neo4j
NEO4J_URI=bolt://replace-with-neo4j-host:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-neo4j-password

# Agent 成本与重试
RUN_TOKEN_BUDGET=200000
MAX_REPAIR_ATTEMPTS=3
